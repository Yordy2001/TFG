{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/uuid-cjs-shim.js",
    "^@nestjs/schedule$": "<rootDir>/nestjs-schedule-cjs-shim.js"
  }
}
