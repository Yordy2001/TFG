// Esquema de Prisma para GuardianEdu.
// Migración de tablas para el centro educativo real (Santiago Oeste, Regional 08).
// Los modelos reflejan uno a uno las entidades de src/common/interfaces/entities.ts.
// Los repositorios de NestJS siguen usando MockDataStore por ahora; conectarlos a
// Prisma es un cambio aparte, no incluido en esta migración.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  REGISTRO
  DIRECTOR
  DOCENTE
  ORIENTADOR
}

enum Sexo {
  M
  F
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
  AUSENCIA_JUSTIFICADA
}

enum EstadoSeguimiento {
  ABIERTO
  EN_PROCESO
  PENDIENTE_INTERVENCION
  CERRADO
}

enum Competencia {
  C1_COMUNICATIVA
  C2_LOGICO_CIENTIFICA
  C3_ETICA_CIUDADANA
}

enum PeriodoEvaluativo {
  P1
  P2
  P3
  P4
}

enum CategoriaObservacion {
  INCIDENTE
  ACTITUD_POSITIVA
  CONVIVENCIA
  OBSERVACION_ACADEMICA
}

enum EstadoFinalPeriodo {
  ACTIVO
  ABANDONO
  TRASLADO
  EGRESADO
  FALLECIDO
}

enum FuenteConfirmacion {
  SIGERD
  REGISTRO_MANUAL_CENTRO
  ORIENTADOR
}

model CentroEducativo {
  id                String   @id @default(uuid())
  codigo            String   @unique
  nombre            String
  telefono          String
  distritoEducativo String
  regional          String
  provincia         String
  municipio         String
  director          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usuarios             Usuario[]
  cursos               Curso[]
  estudiantes          Estudiante[]
  asignaturas          Asignatura[]
  periodosAcademicos   PeriodoAcademico[]
  asignacionesDocentes AsignacionDocente[]
  actividades          ActividadEvaluacion[]
  registrosEvaluacion  RegistroEvaluacion[]
  asistencias          AsistenciaRegistro[]
  seguimientos         SeguimientoOrientador[]
  observacionesAula    ObservacionAula[]
  riesgos              Riesgo[]
  historialRiesgo      HistorialRiesgo[]
  desenlaces           DesenlaceEstudiante[]
  historialAcademico   HistorialAcademico[]
  agregadosAsistencia  AgregadoAsistenciaMensual[]
  historialEstadoSeguimiento HistorialEstadoSeguimiento[]
  identidadMapping    IdentidadEstudianteMapping[]
  reportesCalidadDato ReporteCalidadDato[]

  @@map("centros_educativos")
}

model Usuario {
  id           String   @id @default(uuid())
  centroId     String
  rol          Role
  nombres      String
  apellidos    String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  centro        CentroEducativo         @relation(fields: [centroId], references: [id])
  asignaciones  AsignacionDocente[]     @relation("DocenteAsignaciones")
  seguimientos  SeguimientoOrientador[] @relation("OrientadorSeguimientos")
  observaciones ObservacionAula[]       @relation("DocenteObservaciones")
  refreshTokens RefreshTokenRecord[]
  desenlacesConfirmados DesenlaceEstudiante[] @relation("DesenlacesConfirmados")
  cambiosEstadoSeguimiento HistorialEstadoSeguimiento[] @relation("CambiosEstadoSeguimiento")

  @@index([centroId])
  @@map("usuarios")
}

model Curso {
  id         String   @id @default(uuid())
  centroId   String
  nombre     String
  gradoNivel String
  seccion    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  centro        CentroEducativo     @relation(fields: [centroId], references: [id])
  estudiantes   Estudiante[]
  asignaciones  AsignacionDocente[]
  observaciones ObservacionAula[]

  @@index([centroId])
  @@map("cursos")
}

model Estudiante {
  id                       String   @id @default(uuid())
  centroId                 String
  cursoId                  String
  matricula                String   @unique
  nombres                  String
  apellidos                String
  sexo                     Sexo
  fechaNacimiento          String
  activo                   Boolean  @default(true)
  incidentesDisciplinarios Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  centro              CentroEducativo         @relation(fields: [centroId], references: [id])
  curso               Curso                   @relation(fields: [cursoId], references: [id])
  registrosEvaluacion RegistroEvaluacion[]
  asistencias         AsistenciaRegistro[]
  seguimientos        SeguimientoOrientador[]
  observaciones       ObservacionAula[]
  riesgos             Riesgo[]
  historialRiesgo     HistorialRiesgo[]
  desenlaces          DesenlaceEstudiante[]
  historialAcademico  HistorialAcademico[]
  agregadosAsistencia AgregadoAsistenciaMensual[]
  identidadMapping    IdentidadEstudianteMapping?

  @@index([centroId])
  @@index([cursoId])
  @@map("estudiantes")
}

model Asignatura {
  id        String   @id @default(uuid())
  centroId  String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centro             CentroEducativo      @relation(fields: [centroId], references: [id])
  asignaciones       AsignacionDocente[]
  observaciones      ObservacionAula[]
  historialAcademico HistorialAcademico[]

  @@index([centroId])
  @@map("asignaturas")
}

model PeriodoAcademico {
  id       String  @id @default(uuid())
  centroId String
  nombre   String
  activo   Boolean @default(true)

  centro       CentroEducativo       @relation(fields: [centroId], references: [id])
  asignaciones AsignacionDocente[]
  desenlaces   DesenlaceEstudiante[]

  @@index([centroId])
  @@map("periodos_academicos")
}

model AsignacionDocente {
  id                 String @id @default(uuid())
  centroId           String
  docenteId          String
  cursoId            String
  asignaturaId       String
  periodoAcademicoId String

  centro           CentroEducativo      @relation(fields: [centroId], references: [id])
  docente          Usuario              @relation("DocenteAsignaciones", fields: [docenteId], references: [id])
  curso            Curso                @relation(fields: [cursoId], references: [id])
  asignatura       Asignatura           @relation(fields: [asignaturaId], references: [id])
  periodoAcademico PeriodoAcademico     @relation(fields: [periodoAcademicoId], references: [id])
  actividades      ActividadEvaluacion[]
  asistencias      AsistenciaRegistro[]

  @@index([centroId])
  @@index([docenteId])
  @@index([cursoId])
  @@map("asignaciones_docentes")
}

model ActividadEvaluacion {
  id                  String            @id @default(uuid())
  centroId            String
  asignacionDocenteId String
  nombre              String
  competencia         Competencia
  porcentaje          Int
  periodoEvaluativo   PeriodoEvaluativo
  fecha               String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  centro     CentroEducativo      @relation(fields: [centroId], references: [id])
  asignacion AsignacionDocente    @relation(fields: [asignacionDocenteId], references: [id])
  registros  RegistroEvaluacion[]

  @@index([centroId])
  @@index([asignacionDocenteId])
  @@map("actividades_evaluacion")
}

model RegistroEvaluacion {
  id           String   @id @default(uuid())
  centroId     String
  actividadId  String
  estudianteId String
  nota         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  centro     CentroEducativo     @relation(fields: [centroId], references: [id])
  actividad  ActividadEvaluacion @relation(fields: [actividadId], references: [id])
  estudiante Estudiante          @relation(fields: [estudianteId], references: [id])

  @@unique([actividadId, estudianteId])
  @@index([centroId])
  @@map("registros_evaluacion")
}

model AsistenciaRegistro {
  id                  String           @id @default(uuid())
  centroId            String
  estudianteId        String
  asignacionDocenteId String
  fecha               String
  estado              EstadoAsistencia
  createdAt           DateTime         @default(now())

  centro     CentroEducativo   @relation(fields: [centroId], references: [id])
  estudiante Estudiante        @relation(fields: [estudianteId], references: [id])
  asignacion AsignacionDocente @relation(fields: [asignacionDocenteId], references: [id])

  @@index([centroId])
  @@index([estudianteId])
  @@index([asignacionDocenteId])
  @@map("asistencias")
}

model SeguimientoOrientador {
  id                             String            @id @default(uuid())
  centroId                       String
  estudianteId                  String
  orientadorId                   String
  fecha                          String
  motivo                         String
  observaciones                  String            @db.Text
  acciones                       String            @db.Text
  proximaCita                    String?
  estado                         EstadoSeguimiento
  situacionEconomicaFamiliar     Int?
  apoyoFamiliarPercibido         Int?
  trabajaDurantePeriodoEscolar   Boolean?
  distanciaHogarEscuelaKm        Float?
  problemasFamiliaresReportados  Boolean?
  senalesPreviasAbandono         Boolean?
  factorAjusteOrientador         Float?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  centro           CentroEducativo              @relation(fields: [centroId], references: [id])
  estudiante        Estudiante                  @relation(fields: [estudianteId], references: [id])
  orientador        Usuario                     @relation("OrientadorSeguimientos", fields: [orientadorId], references: [id])
  historialEstados  HistorialEstadoSeguimiento[]

  @@index([centroId])
  @@index([estudianteId])
  @@map("seguimientos_orientador")
}

model HistorialEstadoSeguimiento {
  id            String            @id @default(uuid())
  centroId      String
  seguimientoId String
  estado        EstadoSeguimiento
  cambiadoPorId String
  fecha         DateTime          @default(now())

  centro      CentroEducativo      @relation(fields: [centroId], references: [id])
  seguimiento SeguimientoOrientador @relation(fields: [seguimientoId], references: [id])
  cambiadoPor Usuario               @relation("CambiosEstadoSeguimiento", fields: [cambiadoPorId], references: [id])

  @@index([seguimientoId])
  @@index([centroId])
  @@map("historial_estado_seguimiento")
}

model Riesgo {
  id                      String      @id @default(uuid())
  centroId                String
  estudianteId            String      @unique
  porcentaje              Int
  nivel                   NivelRiesgo
  fechaCalculo            DateTime
  versionReglasRiskEngine String      @default("1.0.0")

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])

  @@index([centroId])
  @@map("riesgos")
}

model HistorialRiesgo {
  id                      String      @id @default(uuid())
  centroId                String
  estudianteId            String
  porcentajeOriginal      Int
  ajusteAplicado          Int
  porcentajeFinal         Int
  nivel                   NivelRiesgo
  usuarioId               String?
  fecha                   DateTime
  versionReglasRiskEngine String      @default("1.0.0")

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])

  @@index([centroId])
  @@index([estudianteId])
  @@map("historial_riesgo")
}

model DesenlaceEstudiante {
  id                     String              @id @default(uuid())
  centroId               String
  estudianteId           String
  periodoAcademicoId     String
  estadoFinalPeriodo     EstadoFinalPeriodo
  fechaEvento            DateTime?           @db.Date
  motivoRegistradoSalida String?
  fuenteConfirmacion     FuenteConfirmacion
  confirmadoPorId        String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  centro           CentroEducativo  @relation(fields: [centroId], references: [id])
  estudiante       Estudiante       @relation(fields: [estudianteId], references: [id])
  periodoAcademico PeriodoAcademico @relation(fields: [periodoAcademicoId], references: [id])
  confirmadoPor    Usuario          @relation("DesenlacesConfirmados", fields: [confirmadoPorId], references: [id])

  @@unique([estudianteId, periodoAcademicoId])
  @@index([centroId])
  @@map("desenlaces_estudiante")
}

model ReporteCalidadDato {
  id                                   String   @id @default(uuid())
  centroId                             String
  generadoEn                           DateTime @default(now())
  entidad                              String
  porcentajeCamposCompletos            Float
  diasDesdeUltimaActualizacionPromedio Int
  inconsistenciasDetectadas            Int
  detalleJson                          Json

  centro CentroEducativo @relation(fields: [centroId], references: [id])

  @@index([centroId])
  @@index([generadoEn])
  @@map("reportes_calidad_dato")
}

model IdentidadEstudianteMapping {
  id             String   @id @default(uuid())
  centroId       String
  estudianteId   String   @unique
  estudianteHash String   @unique
  createdAt      DateTime @default(now())

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])

  @@index([centroId])
  @@map("identidad_estudiante_mapping")
}

model HistorialAcademico {
  id                             String            @id @default(uuid())
  centroId                       String
  estudianteId                   String
  asignaturaId                   String
  periodoEvaluativo              PeriodoEvaluativo
  calificacion                   Float
  reprobo                        Boolean
  numeroVecesRepitenciaAcumulada Int               @default(0)
  calculadoEn                    DateTime          @default(now())

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])
  asignatura Asignatura      @relation(fields: [asignaturaId], references: [id])

  @@unique([estudianteId, asignaturaId, periodoEvaluativo])
  @@index([centroId])
  @@map("historial_academico")
}

model AgregadoAsistenciaMensual {
  id                                String   @id @default(uuid())
  centroId                          String
  estudianteId                      String
  anioMes                           String
  porcentajeAsistenciaMensual       Float
  rachaMaximaAusenciasConsecutivas  Int
  calculadoEn                       DateTime @default(now())

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])

  @@unique([estudianteId, anioMes])
  @@index([centroId])
  @@map("agregados_asistencia_mensual")
}

model ObservacionAula {
  id           String               @id @default(uuid())
  centroId     String
  estudianteId String
  cursoId      String
  asignaturaId String?
  docenteId    String
  categoria    CategoriaObservacion
  fecha        String
  descripcion  String               @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  centro     CentroEducativo @relation(fields: [centroId], references: [id])
  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])
  curso      Curso           @relation(fields: [cursoId], references: [id])
  asignatura Asignatura?     @relation(fields: [asignaturaId], references: [id])
  docente    Usuario         @relation("DocenteObservaciones", fields: [docenteId], references: [id])

  @@index([centroId])
  @@index([estudianteId])
  @@map("observaciones_aula")
}

model RefreshTokenRecord {
  id        String   @id @default(uuid())
  usuarioId String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("refresh_tokens")
}
