# Conexión a la base de datos PostgreSQL levantada por docker-compose.yml
DATABASE_URL="postgresql://guardianedu:guardianedu@localhost:5432/guardianedu?schema=public"

PORT=3000
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=change-me

# Salt used to derive estudianteHash (HMAC-SHA256 of the student's internal UUID)
# for anonymized dataset export. Must be a long random secret managed outside git.
# Rotating it invalidates every existing hash mapping.
IDENTITY_HASH_SALT=change-me
