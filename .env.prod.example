# Copiar como ".env" en la raíz del proyecto (junto a docker-compose.prod.yml)
# y completar con valores reales antes de desplegar. No commitear el ".env" real.

POSTGRES_DB=guardianedu
POSTGRES_USER=guardianedu
POSTGRES_PASSWORD=change-me-strong-password

# Dominio o IP pública del Droplet por donde se accede al frontend (usado por CORS)
# Ejemplo: http://123.45.67.89 o https://mi-dominio.com
CORS_ORIGIN=http://change-me

JWT_SECRET=change-me-long-random-secret
IDENTITY_HASH_SALT=change-me-long-random-secret
